{
  "name": "ispmax-manual",
  "version": "2.0.0",
  "private": true,
  "description": "Manual de usuario de ISPMAX — documentación construida con Rspress 2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "search": "node scripts/build-search-data.mjs",
    "dev": "npm run assets && npm run nav && npm run search && rspress dev",
    "build": "npm run assets && npm run nav && npm run search && rspress build",
    "preview": "rspress preview",
    "nav": "node scripts/build-nav.mjs",
    "check": "node scripts/docs-check.mjs",
    "dev:corpus": "node scripts/manual-corpus.mjs dev",
    "build:corpus": "node scripts/manual-corpus.mjs build",
    "preview:corpus": "node scripts/manual-corpus.mjs preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@rspress/core": "^2.0.18",
    "@tailwindcss/postcss": "^4.3.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
