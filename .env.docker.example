# ─────────────────────────────────────────────────────────────
# ISPMAX · variables del despliegue con Docker Compose
# Copie a `.env` (junto a docker-compose.yml) y ajuste, o deje que lo cree install-docker.sh
# (permisos 600; nunca se sube a Git). La contraseña del administrador NO va aquí.
# ─────────────────────────────────────────────────────────────

# Contraseña de PostgreSQL (OBLIGATORIA). Solo letras y números: va dentro de DATABASE_URL.
# Ejemplo para generarla:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Usuario y base de datos de PostgreSQL (se crean al primer arranque del servicio db).
POSTGRES_USER=ispmax
POSTGRES_DB=ispmax_manual

# Puerto del servidor donde se publica el sistema (el proxy inverso apunta a IP:este-puerto).
PORTAL_PUBLIC_PORT=8387

# UID/GID que ejecuta la aplicación dentro del contenedor: ponga los del propietario del repositorio
# (`stat -c '%u %g' .`), para que los archivos que Git actualice no queden como root.
PUID=1000
PGID=1000

# Zona horaria (afecta a logs y fechas del contenedor).
TZ=UTC

# Detrás de un proxy inverso: confía en X-Forwarded-For/-Proto para la IP y el esquema reales.
# true = UN proxy delante (se toma la última IP que añade el proxy). Con dos proxys encadenados (p. ej. CDN + Nginx)
# ponga 2; lo más seguro es la IP o el rango del proxy (ej. 172.16.0.0/12). Ver portal/SECURITY.md.
PORTAL_TRUST_PROXY=true
# Habilita el panel /admin/ y su API de administración.
PORTAL_ADMIN_ENABLED=true
# Restringe el panel y la API a estas IP/CIDR, separadas por comas (vacío = sin restricción). Ej.: 203.0.113.10,10.0.0.0/8
PORTAL_ADMIN_ALLOWED_IPS=
# Ruta SECRETA del panel: un segmento (minúsculas, números, _ o -; 3 a 64). Con otra distinta de /admin, /admin y /api
# directos responden como cualquier página inexistente y la API queda en <ruta>/api/. Use un sufijo aleatorio largo
# (install-docker.sh genera /panel-<16 hex>); una palabra del diccionario se adivina. Es una capa EXTRA: no sustituye a
# la contraseña fuerte, la verificación en dos pasos ni la lista de IPs. Vacía = /admin.
PORTAL_ADMIN_PATH=
# Accesos a rutas de escaneo (/wp-admin, /.env, *.php…) por IP en 5 min antes de bloquear 30 min el panel a esa IP
# (el manual público nunca se bloquea).
PORTAL_PROBE_THRESHOLD=20
# Clave para cifrar los secretos de la verificación en dos pasos (64 hex: openssl rand -hex 32). Vacía = se genera el
# archivo secret.key en el volumen de datos. No la cambie una vez en uso (la 2FA dejaría de validar; ver SECURITY.md).
PORTAL_SECRET_KEY=
# Sesiones: horas de inactividad y días máximos antes de tener que volver a iniciar sesión.
PORTAL_SESSION_IDLE_H=12
PORTAL_SESSION_MAX_DAYS=7
# Fuerza la cookie de sesión segura (Secure, nombre __Host-portal_session). Vacío = automático: segura cuando el
# protocolo efectivo es https (X-Forwarded-Proto del proxy de confianza).
PORTAL_COOKIE_SECURE=
# Orígenes permitidos para peticiones del navegador, separados por comas. Ej.: https://manual.example.com
PORTAL_ALLOWED_ORIGINS=

# Repositorio PRIVADO por SSH: ruta (en el servidor) a una clave de despliegue de solo lectura.
# Vacío = no se monta ninguna. Alternativa: token en la URL del remoto (ver portal/DEPLOY.md).
GIT_DEPLOY_KEY_FILE=

# Dirección pública del manual (canonical, sitemap.xml, robots.txt, Open Graph y datos estructurados). Sin barra final.
# Cambiarla exige reconstruir el sitio (/admin/ -> Sistema -> «Reconstruir ahora»). Vacía = sin definir: el sitio se
# genera sin canonical y el sitemap usa el host de la petición.
PORTAL_PUBLIC_URL=https://doc.ispmax.ec
