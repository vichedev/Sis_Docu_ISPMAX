# Copiar a portal/.env (ignorado por Git). Nunca subir claves.
DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:5432/ispmax_manual
TEST_DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:5432/ispmax_manual_test
PORTAL_PORT=4380
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=cambia-esto
PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# Opcionales
# PORTAL_HOST=127.0.0.1            # 0.0.0.0 solo con proxy HTTPS delante
# PORTAL_COOKIE_SECURE=1           # si se accede por HTTPS
# Asistente de IA (Groq): la clave también se puede guardar desde Ajustes (cifrada en la BD; manda sobre esta)
# GROQ_API_KEY=                    # clave de Groq (nunca subirla a Git)
# GROQ_MODEL=openai/gpt-oss-120b
# PORTAL_AI_RATE=20                # peticiones de IA por persona cada 10 minutos
# PORTAL_AI_HISTORY_DAYS=90        # días que se conservan las conversaciones del asistente (0 = sin caducidad)
# GROQ_BASE_URL=                   # solo para pruebas con un servidor falso
# PORTAL_ENV_FILE=/etc/ispmax/portal.env   # usar otro archivo en lugar de portal/.env (solo variable de entorno real)
# En un servidor, install.sh genera este archivo y NO guarda la contraseña del administrador.
